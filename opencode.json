{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/instructions/feature-workflow.md"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    }
  },
  "lsp": {
    "typescript-language-server": {
      "command": ["pnpm", "exec", "typescript-language-server", "--stdio"],
      "extensions": ["js", "jsx", "ts", "tsx"]
    }
  }
}
